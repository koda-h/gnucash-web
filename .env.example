# docker compose の設定。.env にコピーして使う（cp .env.example .env）

# GnuCash ファイルを置くフォルダ（compose.yaml からの相対パス、または絶対パス）とファイル名
# 既定はプロジェクト直下の data/（Git では管理しない）。バックアップは data/backup/ に作られる
# ※ シンボリックリンクはコンテナ内で辿れないため、ファイルの実体を置くこと
GNUCASH_DATA_DIR=./data
GNUCASH_FILE_NAME=gnucash.gnucash

# ブラウザで開くポート（http://127.0.0.1:8000/）
GNUCASH_WEB_PORT=8000

# 1 = 編集可（起動時にバックアップを作成）、0 = 読み取り専用
GNUCASH_WRITE=1

# 1 = GnuCash デスクトップのロック（gnclock）が残っていても書き込む
#     0 にしておくと、デスクトップ版で開いている間は書き込みを自動で拒否する（推奨）
GNUCASH_FORCE=0

# 取引日の表示に使うタイムゾーン
GNUCASH_TZ=Asia/Tokyo
