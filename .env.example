# docker compose の設定。.env にコピーして使う（cp .env.example .env）

# GnuCash ファイルを置くフォルダ（compose.yaml からの相対パス、または絶対パス）とファイル名
# 既定はプロジェクト直下の data/（Git では管理しない）。バックアップは data/backup/ に作られる
# ※ シンボリックリンクはコンテナ内で辿れないため、ファイルの実体を置くこと
GNUCASH_DATA_DIR=./data
GNUCASH_FILE_NAME=gnucash.gnucash

# ブラウザで開くポート（http://127.0.0.1:8000/）
GNUCASH_WEB_PORT=8000

# 1 = 編集可（起動時にバックアップを作成）、0 = 読み取り専用
GNUCASH_WRITE=1

# 1 = GnuCash デスクトップのロック（gnclock）が残っていても書き込む
#     0 にしておくと、デスクトップ版で開いている間は書き込みを自動で拒否する（推奨）
GNUCASH_FORCE=0

# 取引日の表示に使うタイムゾーン
GNUCASH_TZ=Asia/Tokyo

# ---- パスキー認証 ----
# 1 = 有効（ログインが必要）、0 = 無効（今までどおり誰でも使える）
# 有効にして起動すると、パスキー未登録の間はログに「初回登録用トークン」が表示される
#   docker compose logs gnucash-web | grep トークン
GNUCASH_AUTH=0

# パスキーを結び付けるドメイン名（IP アドレスは不可）。ブラウザで開く URL のホスト名と一致させる
# 後から変えるとパスキーの登録し直しが必要になる
#   このMacだけ   : localhost（http://localhost:8000 で開く。127.0.0.1 では使えない）
#   Tailscale 経由: mymac.tailxxxx.ts.net など
GNUCASH_AUTH_RP_ID=localhost

# ブラウザで開く URL（スキーム・ホスト・ポート）。他サイトからの操作の防止にも使う
GNUCASH_AUTH_ORIGIN=http://localhost:8000

# ログイン状態の有効期間（日）
GNUCASH_AUTH_SESSION_DAYS=30
