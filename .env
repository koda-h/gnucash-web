# docker compose の設定。.env にコピーして使う（cp .env.example .env）

# GnuCash ファイルの実体があるフォルダ（絶対パス、または compose.yaml からの相対パス）とファイル名
# ※ シンボリックリンクはコンテナ内で辿れないため、リンク先のフォルダを指定する
GNUCASH_DATA_DIR=/Users/koda/Documents/gnucash
GNUCASH_FILE_NAME=gnucash.gnucash

# 編集モードで起動したときのバックアップ保存先
GNUCASH_BACKUP_PATH=./backup

# ブラウザで開くポート（http://127.0.0.1:8000/）
GNUCASH_WEB_PORT=8000

# 1 = 編集可（起動時にバックアップを作成）、0 = 読み取り専用
GNUCASH_WRITE=1

# 1 = GnuCash デスクトップのロック（gnclock）が残っていても書き込む
#     デスクトップ版で同じファイルを開いていないときだけ 1 にすること
GNUCASH_FORCE=1

# 取引日の表示に使うタイムゾーン
GNUCASH_TZ=Asia/Tokyo
